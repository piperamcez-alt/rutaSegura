# ─── Django ───────────────────────────────────────────────
# Genera una clave segura con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura-larga

# En producción (Railway) debe ser False
DJANGO_DEBUG=False

# Dejar vacío en Railway — el dominio se detecta automáticamente
# con la variable RAILWAY_PUBLIC_DOMAIN.
DJANGO_ALLOWED_HOSTS=

# Agrega aquí el dominio de tu app si tienes dominio propio:
# CSRF_TRUSTED_ORIGINS=https://tuapp.up.railway.app,https://tudominio.com

# ─── Supabase – PostgreSQL ────────────────────────────────
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_DE_SUPABASE
DB_HOST=db.TU_PROJECT_REF.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# Alternativa: si usas el plugin PostgreSQL nativo de Railway,
# define DATABASE_URL y deja las variables DB_* vacías.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Supabase – API ───────────────────────────────────────
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_KEY=TU_CLAVE_ANON_PUBLISHABLE
