# ─── Django ───────────────────────────────────────────────
# Genera una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura-larga

DJANGO_DEBUG=False

# Deja vacío: Railway lo detecta automáticamente
DJANGO_ALLOWED_HOSTS=

# ─── Supabase – PostgreSQL ────────────────────────────────
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_DE_SUPABASE
DB_HOST=db.TU_PROJECT_REF.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# ─── Supabase – API ───────────────────────────────────────
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_KEY=TU_CLAVE_ANON_PUBLISHABLE
